# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# ---- PayPal (REST v2) ----
# "sandbox" for development/testing, "live" only after merchant verification
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
# Webhook ID shown in the PayPal developer dashboard for your webhook endpoint
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id

# ---- Uploads (verification documents) ----
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# ---- Staging only: lets sample-flagged products and sample FX rates be used with NODE_ENV=production.
# Never set in a real production deployment.
# ALLOW_SAMPLE_DATA=true

# ---- Email (when unset, emails are only written to the outbox table; e.g. smtps://user:pass@smtp.example.com:465) ----
SMTP_URL=
MAIL_FROM="Valden Trade Desk <no-reply@example.com>"

# ---- Public company contact details (shown only if set) ----
COMPANY_LEGAL_NAME=
COMPANY_SUPPORT_EMAIL=
COMPANY_SUPPORT_PHONE=
COMPANY_ADDRESS=

# ---- Accessibility coordinator shown on /accessibility (shown only if set; otherwise the contact form is linked) ----
ACCESSIBILITY_COORDINATOR_NAME=
ACCESSIBILITY_COORDINATOR_EMAIL=
ACCESSIBILITY_COORDINATOR_PHONE=

# ---- First deploy only: creates a super admin with this email and logs a one-time set-password link ----
# BOOTSTRAP_ADMIN_EMAIL=
